	(text "Amphenol TSW-10 A washing machine sensor \nbut it's calibrated!\n"
		(exclude_from_sim no)
		(at 3.81 3.048 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "48e8b1bb-f70f-4191-8d82-e8961438ed20")
	)
	(text "GAIN=1"
		(exclude_from_sim no)
		(at 32.766 100.838 0)
		(effects
			(font
				(size 1.27 1.27)
			)
